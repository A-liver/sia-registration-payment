# Copy this file to .env and fill in your own values. Never commit .env.

# Main API and portal
PORT=3000

# MySQL (local, for example from XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sia_registration

# Legacy student records mock
LEGACY_RECORDS_URL=http://localhost:4001
LEGACY_TIMEOUT_MS=3000

# Payment gateway: "stub" (default, no internet needed) or "paypal" (sandbox)
PAYMENT_GATEWAY=stub
PAYPAL_STUB_URL=http://localhost:4002
PAYMENT_TIMEOUT_MS=5000

# PayPal sandbox credentials (only needed when PAYMENT_GATEWAY=paypal)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Recovery worker
RETRY_LIMIT=5

# Legacy records mock
LEGACY_PORT=4001
LEGACY_DB_NAME=sia_legacy
PAYPAL_STUB_PORT=4002
